# Copy to .env (scripts/setup-linux.sh does this and fills in unique passwords). Never commit .env.
# Paths are relative to the checkout; the Docker image runs from /app with the same layout, so
# one .env serves both `docker compose run --rm crawler ...` and a native `stock-crawler ...`.

# ---- what to fetch -----------------------------------------------------------------------------
SOURCE_MODE=kap-export
COMPANY_FILE=config/companies.txt
KAP_COMPANY_REGISTRY=config/kap_companies.json
# 1-5 years per request (a KAP limit). Older history: import your colleague's manifests instead.
KAP_YEARS=[2024,2025]
# Issuers whose financial year is NOT Jan-Dec; they are skipped because the export has no period dates.
KAP_NON_CALENDAR_YEAR_TICKERS=[]
DATA_DIR=data
LOG_LEVEL=INFO
HTTP_USER_AGENT=StockFundamentalsMVP/0.2 (+operator contact: replace-me@example.com)

# If this host reaches KAP only through a VPN or proxy, containers do not inherit it. Run a proxy on
# the host and point the crawler at it (host.docker.internal is mapped to the host in docker-compose.yml):
# HTTPS_PROXY=socks5://host.docker.internal:1080

# ---- pacing (one POST covers up to 25 companies) ----------------------------------------------
REQUEST_DELAY_MIN_SECONDS=5
REQUEST_DELAY_MAX_SECONDS=10
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=2
MAX_COMPANIES_PER_RUN=250
MAX_REQUESTS_PER_RUN=50
DISCOVERY_INTERVAL_HOURS=24

# ---- SQL Server (containers) --------------------------------------------------------------------
# Linux: the crawler container runs as this uid/gid so bind-mounted ./data and ./config stay writable.
CRAWLER_UID=1000
CRAWLER_GID=1000
MSSQL_HOST=mssql
MSSQL_PORT=1433
MSSQL_DATABASE=StockFundamentals
MSSQL_ENCRYPT=yes
# Self-signed certificate inside the Compose network: yes. Production: no + a trusted certificate.
MSSQL_TRUST_SERVER_CERTIFICATE=yes
# The SQL Server container reads these two directly.
MSSQL_SA_PASSWORD=REPLACE_WITH_STRONG_SA_PASSWORD
ACCEPT_EULA=Y
MSSQL_PID=Express
# init-db connects as sa once, then creates least-privilege logins with the passwords below.
MSSQL_BOOTSTRAP_USER=sa
MSSQL_BOOTSTRAP_PASSWORD=REPLACE_WITH_STRONG_SA_PASSWORD
MSSQL_USER=crawler_writer
MSSQL_PASSWORD=REPLACE_WITH_LOCAL_SECRET
MSSQL_READER_PASSWORD=REPLACE_WITH_LOCAL_SECRET
MSSQL_GRAFANA_PASSWORD=REPLACE_WITH_LOCAL_SECRET

# ---- Grafana ------------------------------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=REPLACE_WITH_LOCAL_SECRET

# ---- offline test data (SOURCE_MODE=fixture only) ------------------------------------------------
FIXTURE_SOURCE_DIR=tests/fixtures/kap/source
