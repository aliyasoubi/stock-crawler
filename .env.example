# Copy to .env and replace secrets. Never commit .env.
COMPANY_FILE=/app/config/companies.txt
DATA_DIR=/app/data
LOG_LEVEL=INFO
HTTP_USER_AGENT=StockFundamentalsMVP/0.1 (+operator contact: replace-me@example.com)

# Source access. `fixture` replays a local directory of captured filings with zero network
# requests; `kap` requires the verified access route described in README section 6.
SOURCE_MODE=fixture
FIXTURE_SOURCE_DIR=/app/tests/fixtures/kap/source

# Runtime SQL account used by `sync`, `reprocess`, `compare` (never sa).
MSSQL_HOST=mssql
MSSQL_PORT=1433
MSSQL_DATABASE=StockFundamentals
MSSQL_USER=crawler_writer
MSSQL_PASSWORD=REPLACE_WITH_LOCAL_SECRET
MSSQL_ENCRYPT=yes
# Self-signed certificate inside the local Compose network: yes. Production: no + trusted cert.
MSSQL_TRUST_SERVER_CERTIFICATE=yes

# Bootstrap account used only by `init-db` to create the database, schema, and least-privilege logins.
MSSQL_BOOTSTRAP_USER=sa
MSSQL_BOOTSTRAP_PASSWORD=REPLACE_WITH_STRONG_SA_PASSWORD
# Passwords that init-db assigns to the least-privilege logins it creates.
MSSQL_READER_PASSWORD=REPLACE_WITH_LOCAL_SECRET
MSSQL_GRAFANA_PASSWORD=REPLACE_WITH_LOCAL_SECRET

# The SQL Server container reads these two directly.
MSSQL_SA_PASSWORD=REPLACE_WITH_STRONG_SA_PASSWORD
ACCEPT_EULA=Y

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=REPLACE_WITH_LOCAL_SECRET

REQUEST_DELAY_MIN_SECONDS=5
REQUEST_DELAY_MAX_SECONDS=10
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=2
DISCOVERY_INTERVAL_HOURS=24
REPORT_REVALIDATE_HOURS=168
MAX_COMPANIES_PER_RUN=25
MAX_REQUESTS_PER_RUN=200
