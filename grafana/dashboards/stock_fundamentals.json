        "sort": 1,
        "query": "SELECT DISTINCT ticker FROM dbo.vw_latest_fundamentals ORDER BY ticker",
        "definition": "SELECT DISTINCT ticker FROM dbo.vw_latest_fundamentals ORDER BY ticker",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Latest annual fundamentals per company** (view `vw_latest_fundamentals`). Monetary values are already normalised to base currency units (`currency_code`); do not multiply by `currency_scale` again. Empty cells mean *unavailable or not safely derivable*, never zero. Companies can be on different latest fiscal years - check `fiscal_year` before comparing."
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Latest annual fundamentals (base currency units)",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "mssql",
            "uid": "stockfundamentals-mssql"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ticker, company_name, fiscal_year, period_end_date, consolidation_scope, currency_code,\n       revenue, net_profit, profit_attributable_to_owners_of_parent, operating_income, ebitda, ebitda_method,\n       total_assets, total_equity, total_debt, total_debt_method, cash_and_cash_equivalents, free_cash_flow,\n       free_cash_flow_method, eps, shares_outstanding, finance_sector_revenue, published_at, retrieved_at, parser_version FROM dbo.vw_latest_fundamentals WHERE ticker IN ($ticker) ORDER BY ticker",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "unavailable",
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "revenue|net_profit|profit_attributable.*|operating_income|ebitda|total_assets|total_equity|total_debt|cash_and_cash_equivalents|free_cash_flow|finance_sector_revenue"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Revenue (latest annual)",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "mssql",
            "uid": "stockfundamentals-mssql"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ticker AS metric, revenue AS value FROM dbo.vw_latest_fundamentals WHERE ticker IN ($ticker) ORDER BY ticker",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^value$/",
          "values": false
        },
        "textMode": "value_and_name",
