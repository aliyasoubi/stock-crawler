# Copy to config/warehouse.env. This file takes precedence over Docker MSSQL_* variables.
# Ubuntu warehouse wrapper uses host networking, so the published SQL port is on loopback.
MSSQL_HOST=127.0.0.1
MSSQL_PORT=1433
MSSQL_DATABASE=StockFundamentals
MSSQL_USER=crawler_writer
MSSQL_PASSWORD=CHANGE_ME
MSSQL_ENCRYPT=yes
MSSQL_TRUST_SERVER_CERTIFICATE=yes

# For init-db only, make a separate config/warehouse-admin.env with an existing
# DDL-capable SQL login (for example sa and its existing password). The database
# must already exist. With ordinary Compose networking use MSSQL_HOST=mssql.
